{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "@webgpu/types"
    ],
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "ts/**/*.ts",
    "ts/**/*.d.ts",
    "runtime/typescript/**/*.ts",
    "runtime/generated/typescript/**/*.ts",
    "tests/types/**/*.ts"
  ]
}
