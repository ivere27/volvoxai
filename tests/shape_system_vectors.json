{
  "format": "volvox-shape-system-vectors/v1",
  "max_safe_integer": 9007199254740991,
  "success_cases": [
    {
      "id": "constant-and-symbolic",
      "dimensions": [
        { "name": "S", "min": 2, "max": 8, "multiple_of": 2 },
        { "name": "B", "min": 1, "max": 4 }
      ],
      "inputs": [
        { "name": "tokens", "dtype": "int32", "shape": ["B", "S"] },
        { "name": "scale", "dtype": "float32", "shape": [1] }
      ],
      "views": {
        "tokens": { "dtype": "int32", "shape": [2, 4], "byte_length": 32 },
        "scale": { "dtype": "float32", "shape": [1], "byte_length": 4 }
      },
      "expected": {
        "signature": "v1|5:scale|1:1|6:tokens|2:2,4",
        "symbols": [["B", 2], ["S", 4]],
        "input_order": ["scale", "tokens"],
        "element_counts": { "scale": 1, "tokens": 8 },
        "byte_lengths": { "scale": 4, "tokens": 32 },
        "metadata_snapshot": true,
        "retain_data_identity": true
      }
    },
    {
      "id": "repeated-symbol-equality",
      "dimensions": [
        { "name": "B", "min": 1, "max": 4 }
      ],
      "inputs": [
        { "name": "b", "dtype": "int8", "shape": ["B", 2] },
        { "name": "a", "dtype": "int8", "shape": ["B", 2] }
      ],
      "views": {
        "b": { "dtype": "int8", "shape": [3, 2], "byte_length": 6 },
        "a": { "dtype": "int8", "shape": [3, 2], "byte_length": 6 }
      },
      "expected": {
        "signature": "v1|1:a|2:3,2|1:b|2:3,2",
        "symbols": [["B", 3]],
        "input_order": ["a", "b"],
        "element_counts": { "a": 6, "b": 6 },
        "byte_lengths": { "a": 6, "b": 6 }
      }
    },
    {
      "id": "unsigned-utf8-input-order",
      "dimensions": [],
      "inputs": [
        { "name": "é", "dtype": "uint8", "shape": [3] },
        { "name": "z", "dtype": "int8", "shape": [2] },
        { "name": "a", "dtype": "float32", "shape": [1] }
      ],
      "views": {
        "é": { "dtype": "uint8", "shape": [3], "byte_length": 3 },
        "z": { "dtype": "int8", "shape": [2], "byte_length": 2 },
        "a": { "dtype": "float32", "shape": [1], "byte_length": 4 }
      },
      "expected": {
        "signature": "v1|1:a|1:1|1:z|1:2|2:é|1:3",
        "symbols": [],
        "input_order": ["a", "z", "é"],
        "element_counts": { "a": 1, "z": 2, "é": 3 },
        "byte_lengths": { "a": 4, "z": 2, "é": 3 }
      }
    }
  ],
  "failure_cases": [
    {
      "id": "same-byte-wrong-constant-shape",
      "operation": "bind",
      "dimensions": [],
      "inputs": [
        { "name": "image", "dtype": "float32", "shape": [2, 2] }
      ],
      "views": {
        "image": { "dtype": "float32", "shape": [1, 4], "byte_length": 16 }
      },
      "expected_error": {
        "code": "DIMENSION_MISMATCH",
        "path": "execution input 'image'.shape[0]"
      }
    },
    {
      "id": "repeated-symbol-conflict-with-same-bytes",
      "operation": "bind",
      "dimensions": [
        { "name": "B", "min": 1, "max": 4 }
      ],
      "inputs": [
        { "name": "a", "dtype": "int32", "shape": ["B", 2] },
        { "name": "b", "dtype": "int32", "shape": ["B", 2] }
      ],
      "views": {
        "a": { "dtype": "int32", "shape": [2, 2], "byte_length": 16 },
        "b": { "dtype": "int32", "shape": [1, 4], "byte_length": 16 }
      },
      "expected_error": {
        "code": "SYMBOL_CONFLICT",
        "path": "execution input 'b'.shape[0]"
      }
    },
    {
      "id": "bound-violation",
      "operation": "bind",
      "dimensions": [
        { "name": "B", "min": 1, "max": 4 }
      ],
      "inputs": [
        { "name": "x", "dtype": "float32", "shape": ["B"] }
      ],
      "views": {
        "x": { "dtype": "float32", "shape": [5], "byte_length": 20 }
      },
      "expected_error": {
        "code": "BOUND_VIOLATION",
        "path": "execution input 'x'.shape[0]"
      }
    },
    {
      "id": "multiple-of-violation",
      "operation": "bind",
      "dimensions": [
        { "name": "S", "min": 2, "max": 8, "multiple_of": 2 }
      ],
      "inputs": [
        { "name": "x", "dtype": "int32", "shape": ["S"] }
      ],
      "views": {
        "x": { "dtype": "int32", "shape": [3], "byte_length": 12 }
      },
      "expected_error": {
        "code": "MULTIPLE_OF_VIOLATION",
        "path": "execution input 'x'.shape[0]"
      }
    },
    {
      "id": "byte-length-mismatch",
      "operation": "bind",
      "dimensions": [],
      "inputs": [
        { "name": "x", "dtype": "int8", "shape": [4] }
      ],
      "views": {
        "x": { "dtype": "int8", "shape": [4], "byte_length": 3 }
      },
      "expected_error": {
        "code": "BYTE_LENGTH_MISMATCH",
        "path": "execution input 'x'.data"
      }
    },
    {
      "id": "malformed-symbol-name",
      "operation": "environment",
      "dimensions": [
        { "name": "bad-name", "min": 1, "max": 2 }
      ],
      "expected_error": {
        "code": "INVALID_CONSTRAINT",
        "path": "dimension constraints[0].name"
      }
    },
    {
      "id": "symbol-name-over-64-characters",
      "operation": "environment",
      "dimensions": [
        { "name": "Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "min": 1, "max": 2 }
      ],
      "expected_error": {
        "code": "INVALID_CONSTRAINT",
        "path": "dimension constraints[0].name"
      }
    },
    {
      "id": "empty-multiple-domain",
      "operation": "environment",
      "dimensions": [
        { "name": "B", "min": 2, "max": 3, "multiple_of": 4 }
      ],
      "expected_error": {
        "code": "INVALID_CONSTRAINT",
        "path": "dimension constraints[0]"
      }
    },
    {
      "id": "byte-count-overflow",
      "operation": "tensor_byte_length",
      "shape": [9007199254740991],
      "dtype": "int32",
      "path": "vector tensor",
      "expected_error": {
        "code": "ARITHMETIC_OVERFLOW",
        "path": "vector tensor byte length"
      }
    }
  ]
}
